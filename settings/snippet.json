{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline/statusline-command.sh"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/statusline/hooks/record-activity.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/statusline/hooks/record-activity.sh" },
          { "type": "command", "command": "bash ~/.claude/statusline/hooks/update-terminal-title.sh" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/statusline/hooks/session-name-check.sh" }
        ]
      }
    ]
  }
}
